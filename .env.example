# ============================================================
# zk-pool — example environment file
# ============================================================
# Скопируй в нужные места:
#   cp .env.example workspace/ptrans/.env
#   cp .env.example workspace/ptrans/app/frontend/.env
# и замени значения на свои.
# ============================================================

# ---------- Solana ----------
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WALLET=~/.config/solana/id.json

# ---------- Program IDs (devnet) ----------
PROGRAM_ID=FbXJSZ171dcnHJVrd5E6KwvXAx7bMgxC44McF84vJ6cK
VERIFIER_PROGRAM_ID=EewognjaJhZUQgP59BrCx5SaJcsFQ6sn65FEwZ2FdZhg

# ---------- Backend ----------
PORT=4001
RUST_LOG=info
PROVER_URL=http://localhost:4002
MERKLE_URL=http://localhost:4003

# ---------- Database ----------
DATABASE_URL=postgres://ptrans:ptrans_dev_password@localhost:5432/ptrans
REDIS_URL=redis://localhost:6379

# ---------- Pool ----------
# PDA: ["pool3"] от PROGRAM_ID
# Обновляется после `anchor deploy` — узнать через
#   const [pda] = await findPoolPda();
POOL_ADDRESS=TQYnBSBF3z3FxMHupvt3cbKYXqsorYY9gYb19rjCncN

# ---------- Frontend (Vite) ----------
# ВАЖНО: Vite требует префикс VITE_ для переменных, доступных в браузере
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_PROGRAM_ID=FbXJSZ171dcnHJVrd5E6KwvXAx7bMgxC44McF84vJ6cK
VITE_VERIFIER_PROGRAM_ID=EewognjaJhZUQgP59BrCx5SaJcsFQ6sn65FEwZ2FdZhg
VITE_API_URL=http://localhost:4001
VITE_MERKLE_URL=http://localhost:4003
VITE_PAYER=4aPAEEmJdLz4fYE44Krad3MP8Q1wAUScg3zMuC8fcBur
VITE_MERKLE_TREE_DEPTH=20
VITE_MIN_DEPOSIT=0.01

# ---------- Prover ----------
PROVER_PORT=4002

# ---------- Merkle ----------
MERKLE_PORT=4003

# ---------- Prometheus / Grafana ----------
# Настраивается через docker-compose.yml и grafana/provisioning/
